{
  "name": "lyrical",
  "version": "1.0.0",
  "description": "Starter point for a graphQL course",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/StephenGrider/Lyrical-GraphQL"
  },
  "scripts": {
    "mongo:start": "docker-compose up -d",
    "mongo:stop": "docker-compose down",
    "mongo:reset": "docker-compose down -v && docker-compose up -d",
    "nodemon": "nodemon index.js --ignore client",
    "format": "prettier --write ./client/**/*.js ./server/**/*.js"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "apollo-client": "^0.8.1",
    "axios": "0.30.2",
    "babel-core": "^6.22.1",
    "babel-loader": "^10.0.0",
    "babel-preset-env": "^1.1.8",
    "babel-preset-react": "^6.22.0",
    "body-parser": "^1.20.4",
    "connect-mongo": "^6.0.0",
    "css-loader": "^7.1.2",
    "express": "^4.22.1",
    "express-graphql": "0.6.1",
    "express-session": "^1.18.2",
    "graphql": "^0.8.2",
    "html-webpack-plugin": "^5.6.5",
    "lodash": "^4.17.4",
    "mongoose": "^7.8.4",
    "passport": "0.6.0",
    "passport-local": "^1.0.0",
    "react": "^19.2.3",
    "react-apollo": "^0.9.0",
    "react-dom": "^19.2.3",
    "react-router": "^3.0.2",
    "style-loader": "^0.13.1",
    "webpack": "^5.104.1",
    "webpack-dev-middleware": "^5.3.4"
  },
